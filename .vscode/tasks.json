{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve website",
            "type": "shell",
            "command": "python3",
            "args": [
                "-u",
                "-m",
                "http.server",
                "8080",
                "--bind",
                "127.0.0.1"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "website-server",
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Serving HTTP on.*$",
                    "endsPattern": "^Serving HTTP on.*$"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
